#!/usr/bin/env bb
;; Snapshot the working tree into a commit stored under
;; refs/snapshots/<branch>/<name>, leaving the index and the checked-out branch
;; untouched. Git dispatches `git snapshot <command>` to this executable.
;;
;; A snapshot is a commit whose tree is the working tree (untracked files
;; included, ignored files excluded, skip-worktree files at their committed
;; version). Snapshots on a branch form a chain: each
;; one's parent is the branch's previous snapshot, or HEAD for the first, so
;; `git show <snapshot>` is that step's diff and `git log -p` on the newest
;; snapshot walks the whole sequence. `git diff HEAD <snapshot>` compares trees,
;; so it still shows all uncommitted work a snapshot captured.
;; Snapshot refs are not branches and are not pushed by default.

(ns git-snapshot
  (:require [babashka.fs :as fs]
            [babashka.process :as p]
            [clojure.string :as str])
  (:import [java.time LocalDateTime]
           [java.time.format DateTimeFormatter]))

(def ref-prefix "refs/snapshots/")

;; Safety copies taken by `replay` before overwriting a dirty working tree.
;; They are kept off the chain so `git log` reads as the sequence of real steps.
(def backup-prefix "pre-replay-")

(def usage
  "usage: git snapshot [list] [--all]
       git snapshot save <name> [message...]
       git snapshot replay <name>
       git snapshot delete <name>
       git snapshot prune [--dry-run]")

(def flags #{"--all" "--dry-run" "-n" "-h" "--help"})

(def nul-separator (re-pattern (str (char 0))))

(defn fail [message]
  (throw (ex-info message {:babashka/exit 1})))

(defn git
  "Run git in `repo` and return trimmed stdout. Throws on non-zero exit."
  [repo & args]
  (str/trim (:out (apply p/shell {:dir repo :out :string} "git" args))))

(defn git-lines [repo & args]
  (remove str/blank? (str/split-lines (apply git repo args))))

(defn git-nul-list
  "Run a git command with NUL-separated output and return its entries."
  [repo & args]
  (remove str/blank? (str/split (apply git repo args) nul-separator)))

(defn current-branch
  "Checked-out branch, or \"detached\" when HEAD is not on a branch."
  [repo]
  (let [{:keys [exit out]} (p/shell {:dir repo :out :string :continue true}
                                    "git" "symbolic-ref" "--short" "-q" "HEAD")]
    (if (zero? exit) (str/trim out) "detached")))

(defn branch-prefix [repo]
  (str ref-prefix (current-branch repo) "/"))

(defn snapshot-ref
  "Ref for snapshot `name` on the current branch."
  [repo name]
  (str (branch-prefix repo) name))

(defn resolve-ref [repo ref]
  (let [{:keys [exit out]} (p/shell {:dir repo :out :string :continue true}
                                    "git" "rev-parse" "-q" "--verify" ref)]
    (when (zero? exit) (str/trim out))))

(defn resolve-snapshot
  "Resolve `name` on the current branch first, then as a full path under
  refs/snapshots/ (another branch's snapshot, or one saved before branch
  namespacing). Returns {:ref :sha} or nil."
  [repo name]
  (some (fn [ref] (when-let [sha (resolve-ref repo ref)] {:ref ref :sha sha}))
        [(snapshot-ref repo name) (str ref-prefix name)]))

(defn display-name [ref prefix]
  (subs ref (count prefix)))

(defn backup-name? [name]
  (str/starts-with? name backup-prefix))

(defn snapshot-entries
  "Snapshot refs under `prefix`, newest first, as
  {:ref :sha :short :parent :date :subject}."
  [repo prefix]
  (->> (git-lines repo "for-each-ref" "--sort=-creatordate"
                  (str "--format=%(refname)%09%(objectname)%09%(objectname:short)%09%(parent)%09"
                       "%(creatordate:format:%Y-%m-%d %H:%M)%09%(subject)")
                  prefix)
       (map #(zipmap [:ref :sha :short :parent :date :subject] (str/split % #"\t" 6)))))

(defn chain-tip
  "The branch chain's newest snapshot: the non-backup entry no other entry has
  as parent. Structural rather than by date, because commit timestamps have
  one-second resolution and agents can save twice within it. Falls back to the
  newest by date if replacements ever leave several tips."
  [entries prefix]
  (let [chained (remove #(backup-name? (display-name (:ref %) prefix)) entries)
        parents (set (map :parent chained))]
    (first (remove #(parents (:sha %)) chained))))

(defn chain-parent
  "Snapshot the next save on the current branch should chain to, or nil."
  [repo]
  (let [prefix (branch-prefix repo)]
    (chain-tip (snapshot-entries repo prefix) prefix)))

(defn excluded-untracked
  "Untracked files matching the pathspecs in the multi-valued git config
  `snapshot.exclude`. They are left out of snapshots and left alone by replay,
  while staying visible in `git status` (unlike .gitignore or info/exclude).
  Only untracked files qualify, so a tracked file matching a pattern is still
  snapshotted rather than recorded as deleted."
  [repo]
  (let [{:keys [exit out]} (p/shell {:dir repo :out :string :continue true}
                                    "git" "config" "--get-all" "snapshot.exclude")
        patterns (when (zero? exit) (remove str/blank? (str/split-lines out)))]
    (when (seq patterns)
      (apply git-nul-list repo "ls-files" "--others" "--exclude-standard" "-z" "--" patterns))))

(defn skip-worktree-paths
  "Tracked paths whose index entry carries the skip-worktree bit, set with
  `git update-index --skip-worktree <path>`: a local edit to a committed file
  that git status, stash and checkout treat as absent. Snapshots record these
  paths at HEAD's version and replay leaves the working copy alone, so a
  per-machine edit is never part of a step. On an unborn branch there is no
  HEAD version and the working copy is recorded."
  [repo]
  (->> (git-nul-list repo "ls-files" "-v" "-z")
       (filter #(re-find #"^[Ss] " %))
       (map #(subs % 2))))

(defn write-worktree-tree
  "Record the working tree as a tree object through a throwaway index, so the
  real index is never touched. The index path must not exist yet: git rejects
  an existing zero-byte index file. The index is seeded from `head` (nil on an
  unborn branch) before `add -A`: ignore rules only filter untracked files, so
  a tracked file that also matches .gitignore stays in the snapshot instead of
  reading as deleted. After `add -A`, `excluded` paths are dropped again and
  `at-head` paths are reset to their `head` entry, which drops one `head` lacks."
  [repo head excluded at-head]
  (let [tmp (fs/create-temp-dir)
        env {"GIT_INDEX_FILE" (str (fs/path tmp "index"))}]
    (try
      (when head
        (p/shell {:dir repo :extra-env env :out :string} "git" "read-tree" head))
      (p/shell {:dir repo :extra-env env :out :string} "git" "add" "-A")
      (when (seq excluded)
        (apply p/shell {:dir repo :extra-env env :out :string} "git" "rm" "--cached" "-q" "--" excluded))
      (when (and head (seq at-head))
        (apply p/shell {:dir repo :extra-env env :out :string} "git" "reset" "-q" head "--" at-head))
      (str/trim (:out (p/shell {:dir repo :extra-env env :out :string} "git" "write-tree")))
      (finally (fs/delete-tree tmp)))))

(defn save
  "Store the working tree as refs/snapshots/<branch>/<name> and return the
  commit sha. The parent is the branch's newest snapshot, else HEAD; backups
  always hang off HEAD. On an unborn branch (no commits yet) the first snapshot
  has no parent. An existing snapshot of the same name is replaced."
  [repo name message]
  (let [prefix (branch-prefix repo)
        ref (str prefix name)
        previous (resolve-ref repo ref)
        head (resolve-ref repo "HEAD")
        chain (when-not (backup-name? name) (chain-parent repo))
        parent (or (:sha chain) head)
        tree (write-worktree-tree repo head (excluded-untracked repo) (skip-worktree-paths repo))
        sha (apply git repo "commit-tree" tree
                   (concat (when parent ["-p" parent]) ["-m" (or message (str "snapshot " name))]))
        base (or head (git repo "hash-object" "-t" "tree" "/dev/null"))]
    (git repo "update-ref" ref sha)
    (println (str name " " (subs sha 0 12)
                  (when chain (str " (after " (display-name (:ref chain) prefix) ")"))
                  (when previous (str " (replaced " (subs previous 0 12) ")"))))
    (print (:out (p/shell {:dir repo :out :string} "git" "diff" "--stat" base sha)))
    (flush)
    sha))

(defn print-entries [entries prefix]
  (doseq [{:keys [ref short date subject]} entries]
    (println (str/join "\t" [(display-name ref prefix) short date subject]))))

(defn chain-ordered
  "Entries in chain order (tip first, like `git log`), then anything off the
  chain, newest first."
  [repo entries prefix]
  (let [order (when-let [tip (chain-tip entries prefix)]
                (zipmap (git-lines repo "rev-list" (:sha tip)) (range)))]
    (sort-by #(get order (:sha %) Long/MAX_VALUE) entries)))

(declare print-prune-hint)

(defn list-snapshots
  "Snapshots on the current branch, with a hint when other branches' snapshots
  are ready to prune."
  [repo]
  (let [prefix (branch-prefix repo)]
    (print-entries (chain-ordered repo (snapshot-entries repo prefix) prefix) prefix))
  (print-prune-hint repo)
  (flush))

(defn snapshot-branch
  "Branch segment of a snapshot ref: the longest existing branch name that
  prefixes its path, or nil for refs saved before branch namespacing or whose
  branch is gone."
  [branches ref]
  (let [segments (str/split (display-name ref ref-prefix) #"/")]
    (->> (range (dec (count segments)) 0 -1)
         (map #(str/join "/" (take % segments)))
         (filter branches)
         first)))

(defn local-branches [repo]
  (set (git-lines repo "for-each-ref" "--format=%(refname:lstrip=2)" "refs/heads/")))

(defn snapshot-groups
  "All snapshots grouped by branch as [branch entries] pairs, sorted by branch
  name with unattributable refs (nil branch) last."
  [repo]
  (let [branches (local-branches repo)]
    (sort-by (fn [[branch]] [(nil? branch) (or branch "")])
             (group-by #(snapshot-branch branches (:ref %)) (snapshot-entries repo ref-prefix)))))

(defn default-branch-ref
  "The default branch as a full ref: origin/HEAD's target when the remote
  advertises one, else a local main or master. nil when none exists."
  [repo]
  (let [{:keys [exit out]} (p/shell {:dir repo :out :string :continue true}
                                    "git" "symbolic-ref" "-q" "refs/remotes/origin/HEAD")]
    (if (zero? exit)
      (str/trim out)
      (some #(when (resolve-ref repo %) %) ["refs/heads/main" "refs/heads/master"]))))

(defn branch-name [ref]
  (str/replace ref #"^refs/(heads|remotes/[^/]+)/" ""))

(defn config-value [repo key]
  (let [{:keys [exit out]} (p/shell {:dir repo :out :string :continue true} "git" "config" "--get" key)]
    (when (zero? exit) (str/trim out))))

(defn upstream-gone?
  "The branch tracks a remote branch that no longer exists: what a squash-merged
  pull request looks like once the hosting side deleted its branch."
  [repo branch]
  (let [remote (config-value repo (str "branch." branch ".remote"))
        merge (config-value repo (str "branch." branch ".merge"))]
    (boolean (and remote merge (not= remote ".")
                  (nil? (resolve-ref repo (str "refs/remotes/" remote "/" (branch-name merge))))))))

(defn checked-out-branches
  "Branches checked out in any worktree of the repo."
  [repo]
  (->> (git-lines repo "worktree" "list" "--porcelain")
       (keep #(second (re-matches #"branch refs/heads/(.+)" %)))
       set))

(defn finished-branch?
  "A branch whose work is over: deleted locally, or neither checked out in any
  worktree nor the default branch, and either upstream gone or merged into the
  default branch. Merged means an ancestor of the default branch with a
  different tip. A branch that is checked out anywhere is never finished: a
  fresh branch with no commits of its own looks exactly like a fast-forwarded
  one once the default branch moves on, and its pre-commit snapshots must
  survive while someone is on it."
  [repo default-ref checked-out branch]
  (let [head-ref (str "refs/heads/" branch)
        tip (resolve-ref repo head-ref)]
    (cond
      (nil? tip) true
      (checked-out branch) false
      (and default-ref (= branch (branch-name default-ref))) false
      (upstream-gone? repo branch) true
      default-ref (and (not= tip (resolve-ref repo default-ref))
                       (zero? (:exit (p/shell {:dir repo :out :string :continue true}
                                              "git" "merge-base" "--is-ancestor" head-ref default-ref))))
      :else false)))

(defn prunable-groups
  "Snapshot groups whose branch is finished, plus refs attributable to no branch
  (saved before branch namespacing, or whose branch was deleted)."
  [repo]
  (let [default-ref (default-branch-ref repo)
        checked-out (checked-out-branches repo)]
    (filter (fn [[branch]] (or (nil? branch) (finished-branch? repo default-ref checked-out branch)))
            (snapshot-groups repo))))

(defn print-prune-hint [repo]
  (let [n (reduce + (map (comp count second) (prunable-groups repo)))]
    (when (pos? n)
      (println (str n " snapshot" (when (not= 1 n) "s") " on finished branches: git snapshot prune")))))

(defn list-all-snapshots
  "Every snapshot in the repo, grouped by branch, unattributable refs last."
  [repo]
  (doseq [[branch entries] (snapshot-groups repo)]
    (let [prefix (if branch (str ref-prefix branch "/") ref-prefix)]
      (println (str "[" (or branch "no branch") "]"))
      (print-entries (chain-ordered repo entries prefix) prefix)))
  (print-prune-hint repo)
  (flush))

(defn prune
  "Delete every snapshot of a finished branch (see `finished-branch?`), and
  every ref attributable to no branch. Snapshots on live or checked-out
  branches stay.
  Deleted refs have no reflog, so the commits become collectable by gc."
  [repo dry-run?]
  (let [groups (prunable-groups repo)]
    (if (empty? groups)
      (println "nothing to prune")
      (doseq [[branch entries] groups]
        (println (str (if dry-run? "would delete " "deleted ") (count entries)
                      " under [" (or branch "no branch") "]"))
        (when-not dry-run?
          (doseq [{:keys [ref]} entries]
            (git repo "update-ref" "-d" ref)))))
    (flush)))

(defn dirty? [repo]
  (not (str/blank? (git repo "status" "--porcelain"))))

(defn timestamp []
  (.format (LocalDateTime/now) (DateTimeFormatter/ofPattern "yyyyMMdd-HHmmss")))

(defn stray-untracked
  "Untracked, non-ignored files in the working tree that the snapshot does not
  contain, minus `snapshot.exclude` matches. `git restore` never removes
  untracked files, so replay deletes these itself to make the working tree
  match the snapshot."
  [repo ref]
  (let [keep (into (set (git-nul-list repo "ls-tree" "-r" "--name-only" "-z" ref))
                   (excluded-untracked repo))]
    (remove keep (git-nul-list repo "ls-files" "--others" "--exclude-standard" "-z"))))

(defn unique-name
  "`base`, or the first `base-N` (N from 2) not already taken by a snapshot."
  [repo base]
  (->> (cons base (map #(str base "-" %) (iterate inc 2)))
       (remove #(resolve-snapshot repo %))
       first))

(defn replay
  "Make the working tree match a snapshot without touching the index, so the
  snapshot's changes appear as unstaged modifications and untracked files.
  Skip-worktree files keep their working copy. A dirty working tree is saved
  first as pre-replay-<timestamp>."
  [repo name]
  (let [{:keys [ref]} (or (resolve-snapshot repo name)
                          (fail (str "no snapshot named " name)))]
    (when (dirty? repo)
      (let [backup (unique-name repo (str backup-prefix (timestamp)))]
        (save repo backup (str "working tree before replaying " name))
        (println "saved current working tree as" backup)))
    (apply git repo "restore" "--source" ref "--worktree" "--" ":/"
           (map #(str ":(exclude,literal)" %) (skip-worktree-paths repo)))
    (doseq [file (stray-untracked repo ref)]
      (fs/delete (fs/path repo file)))
    (print (:out (p/shell {:dir repo :out :string} "git" "status" "--short")))
    (flush)))

(defn delete
  "Drop the ref. The commit stays reachable through any later snapshot that
  chains to it, so deleting a middle snapshot does not break `git log`."
  [repo name]
  (let [{:keys [ref]} (or (resolve-snapshot repo name)
                          (fail (str "no snapshot named " name)))]
    (git repo "update-ref" "-d" ref)
    (println "deleted" (display-name ref ref-prefix))))

(defn -main [args]
  (let [repo (git "." "rev-parse" "--show-toplevel")
        given (set (filter flags args))
        [command name & message] (remove flags args)]
    (cond
      (or (given "-h") (given "--help")) (println usage)
      (or (nil? command) (= "list" command)) (if (given "--all") (list-all-snapshots repo) (list-snapshots repo))
      (= "prune" command) (prune repo (boolean (or (given "--dry-run") (given "-n"))))
      (nil? name) (fail usage)
      (= "save" command) (save repo name (when (seq message) (str/join " " message)))
      (= "replay" command) (replay repo name)
      (= "delete" command) (delete repo name)
      :else (fail usage))))

(when (= *file* (System/getProperty "babashka.file"))
  (-main *command-line-args*))
